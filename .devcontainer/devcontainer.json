{
    "name": "DevelopmentContainerEnv",
    "dockerComposeFile": "../compose.yaml",
    "service": "docker_dev_container_linux",
    "workspaceFolder": "/home/aevers/project",

    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "charliermarsh.ruff",
                "llvm-vs-code-extensions.vscode-clangd",
                "ms-dotnettools.csharpier-vscode",
                "esbenp.prettier-vscode"
            ],
            "settings": {
                "editor.formatOnSave": true,
                "clangd.path": "clangd",
                "clangd.arguments": ["--query-driver=/usr/bin/arm-none-eabi-*"],
                "python.formatting.provider": "none"
            }
        }
    },

    "remoteUser": "aevers"
}