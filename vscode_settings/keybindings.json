[
    // --- FENSTER-NAVIGATION (Vim-Style: Ctrl+hjkl) ---
    {
        "key": "ctrl+h",
        "command": "workbench.action.focusLeftGroup",
        "when": "editorTextFocus && vim.active && vim.mode != 'Insert'"
    },
    {
        "key": "ctrl+l",
        "command": "workbench.action.focusRightGroup",
        "when": "editorTextFocus && vim.active && vim.mode != 'Insert'"
    },
    {
        "key": "ctrl+k",
        "command": "workbench.action.focusAboveGroup",
        "when": "editorTextFocus && vim.active && vim.mode != 'Insert'"
    },
    {
        "key": "ctrl+j",
        "command": "workbench.action.focusBelowGroup",
        "when": "editorTextFocus && vim.active && vim.mode != 'Insert'"
    },

    // --- LAZYVIM LEADER KEYS (Navigation & Suche) ---
    {
        "key": "space e",
        "command": "workbench.view.explorer",
        "when": "editorTextFocus && vim.active && vim.mode == 'Normal'"
    },
    {
        "key": "space f f",
        "command": "workbench.action.quickOpen",
        "when": "editorTextFocus && vim.active && vim.mode == 'Normal'"
    },
    {
        "key": "space space",
        "command": "workbench.action.quickOpen",
        "when": "editorTextFocus && vim.active && vim.mode == 'Normal'"
    },
    {
        "key": "space /",
        "command": "workbench.action.findInFiles",
        "when": "editorTextFocus && vim.active && vim.mode == 'Normal'"
    },

    // --- DEBUGGING (LazyVim Style) ---
    {
        "key": "space d b",
        "command": "editor.debug.action.toggleBreakpoint",
        "when": "editorTextFocus && vim.active && vim.mode == 'Normal'"
    },
    {
        "key": "space d c",
        "command": "workbench.action.debug.continue",
        "when": "editorTextFocus && vim.active && vim.mode == 'Normal'"
    },

    // --- LIST NAVIGATION (Vim-Style in Menüs & Explorer) ---
    {
        "key": "ctrl+j",
        "command": "list.focusDown",
        "when": "listFocus && !inputFocus"
    },
    {
        "key": "ctrl+k",
        "command": "list.focusUp",
        "when": "listFocus && !inputFocus"
    },
    {
        "key": "ctrl+h",
        "command": "list.collapse",
        "when": "listFocus && !inputFocus"
    },
    {
        "key": "ctrl+l",
        "command": "list.select",
        "when": "listFocus && !inputFocus"
    },

    // --- QUICK OPEN NAVIGATION (Ctrl+j/k wie in Telescope) ---
    {
        "key": "ctrl+j",
        "command": "workbench.action.quickOpenSelectNext",
        "when": "inQuickOpen"
    },
    {
        "key": "ctrl+k",
        "command": "workbench.action.quickOpenSelectPrevious",
        "when": "inQuickOpen"
    },

    // --- TERMINAL & SONSTIGES ---
    {
        "key": "ctrl+;",
        "command": "workbench.action.terminal.toggleTerminal"
    },
    {
        "key": "ctrl+enter",
        "command": "renameFile",
        "when": "explorerViewletVisible && filesExplorerFocus"
    },
    {
        "key": "enter",
        "command": "-renameFile",
        "when": "explorerViewletVisible && filesExplorerFocus"
    },
    {
        "key": "enter",
        "command": "list.select",
        "when": "listFocus && !inputFocus"
    },
    {
        "key": "ctrl+l", 
        "command": "workbench.action.focusActiveEditorGroup",
        "when": "filesExplorerFocus"
    },
    // 1. Wenn im Editor: Öffne/Fokussiere den Explorer
    {
        "key": "space e",
        "command": "workbench.view.explorer",
        "when": "editorTextFocus && vim.mode == 'Normal'"
    },

    // 2. Wenn im Explorer: Sidebar einklappen (Toggle-Effekt)
    {
        "key": "space e",
        "command": "workbench.action.toggleSidebarVisibility",
        "when": "filesExplorerFocus && !inputFocus"
    },
    // --- YANK (Kopieren) ---
    {
        "key": "y",
        "command": "filesExplorer.copy",
        "when": "filesExplorerFocus && !inputFocus"
    },

    // --- PASTE (Einfügen) ---
    {
        "key": "p",
        "command": "filesExplorer.paste",
        "when": "filesExplorerFocus && !inputFocus"
    },

    // --- DELETE (Löschen) ---
    {
        "key": "d",
        "command": "deleteFile",
        "when": "filesExplorerFocus && !inputFocus"
    },

    // --- RENAME (Umbenennen - wie 'r' in nvim-tree) ---
    {
        "key": "r",
        "command": "renameFile",
        "when": "filesExplorerFocus && !inputFocus"
    },

    // --- MULTI-SELECT (Markieren mit TAB) ---
    {
        "key": "tab",
        "command": "list.toggleSelection",
        "when": "filesExplorerFocus && !inputFocus"
    },
    {
        "key": "shift+tab",
        "command": "list.toggleSelection",
        "when": "filesExplorerFocus && !inputFocus"
    }
]