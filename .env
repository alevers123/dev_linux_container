# Container-Name
cont_name=vscode_dev_cont

# Build-Argumente
uid=1000
gid=1000
uname=aevers

# Image-Name
image_name=docker_dev_container_linux_image

# WSL / Linux Runtime Variablen
WSL_INTEROP=
DISPLAY=:0
WAYLAND_DISPLAY=
XDG_RUNTIME_DIR=/run/user/1000
PULSE_SERVER=

# HOME wird normalerweise automatisch gesetzt,
# aber falls VS Code es nicht erbt, kannst du es hier definieren:
HOME=/home/aevers